{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silentpartnercoding.github.io/minority-prophet-border/openid-aiim-result-v1.schema.json",
  "title": "OpenID AIIM bilateral interoperability observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "test_id", "tested_at", "tester", "implementation", "features", "evidence"],
  "properties": {
    "schema": {"const": "openid-aiim-result/v1"},
    "test_id": {"type": "string", "minLength": 1},
    "tested_at": {"type": "string", "format": "date-time"},
    "tester": {"$ref": "#/$defs/party"},
    "implementation": {"$ref": "#/$defs/party"},
    "features": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["matrix", "feature", "implementation_role", "outcome"],
      "properties": {
        "matrix": {"enum": ["oauth", "cimd", "ema"]},
        "feature": {"type": "string", "minLength": 1},
        "implementation_role": {"enum": ["mcp_client", "mcp_server", "openid_provider", "oauth_as"]},
        "outcome": {"enum": ["checked", "blank", "unable_to_test"]},
        "note": {"type": "string"}
      }}},
    "evidence": {"type": "object", "additionalProperties": false,
      "required": ["transcript_digest", "configuration_digest", "negative_tests_digest"],
      "properties": {
        "transcript_digest": {"$ref": "#/$defs/digest"},
        "configuration_digest": {"$ref": "#/$defs/digest"},
        "negative_tests_digest": {"$ref": "#/$defs/digest"}
      }}
  },
  "$defs": {
    "party": {"type": "object", "additionalProperties": false, "required": ["name", "role"],
      "properties": {"name": {"type": "string", "minLength": 1},
        "role": {"enum": ["mcp_client", "mcp_server", "mcp_gateway", "openid_provider", "oauth_as"]},
        "version": {"type": "string"}}},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
