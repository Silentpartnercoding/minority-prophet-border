{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://minorityprophet.org/schema/a2a-mcp-crossing-submission-evidence-v2.json",
  "$defs":{
    "adapter_config":{"type":"object","additionalProperties":true,"required":["adapter","version","corpus_consumption","transformations"],"properties":{"adapter":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"corpus_consumption":{"enum":["exact_bytes","identified_transformation"]},"transformations":{"type":"array","items":{"type":"string","minLength":1}}}},
    "implementation":{"type":"object","additionalProperties":false,"required":["components"],"properties":{"components":{"type":"array","minItems":3,"items":{"type":"object","additionalProperties":false,"required":["name","repository","commit"],"properties":{"name":{"type":"string","minLength":1},"repository":{"type":"string","minLength":1},"commit":{"type":"string","pattern":"^[0-9a-f]{40}$"}}}}}},
    "effect_recorder":{"type":"object","additionalProperties":true,"required":["source","outside_verifier"],"properties":{"source":{"type":"string","minLength":1},"outside_verifier":{"const":true}}},
    "replay_store":{"type":"object","additionalProperties":true,"required":["backend","shared_scope","durability"],"properties":{"backend":{"type":"string","minLength":1},"shared_scope":{"type":"string","minLength":1},"durability":{"type":"string","minLength":1}}},
    "caller_source":{"type":"object","additionalProperties":true,"required":["source","transport_authenticated"],"properties":{"source":{"type":"string","minLength":1},"transport_authenticated":{"const":true}}},
    "audience_source":{"type":"object","additionalProperties":true,"required":["source","transport_bound"],"properties":{"source":{"enum":["oauth_resource","authenticated_endpoint","certificate_identity","pinned_configuration"]},"transport_bound":{"const":true}}},
    "status_source_policy":{"type":"object","additionalProperties":true,"required":["source","verification_policy","max_age_seconds"],"properties":{"source":{"type":"string","minLength":1},"verification_policy":{"type":"string","minLength":1},"max_age_seconds":{"type":"integer","minimum":0,"maximum":300}}},
    "grade_evidence":{"type":"object","additionalProperties":true,"required":["claimed_grade","implementation_operator","adapter_operator","relationship"],"properties":{"claimed_grade":{"enum":["reference_fixture","transport_real","implementation_independent","operator_independent"]},"implementation_operator":{"type":"string","minLength":1},"adapter_operator":{"type":"string","minLength":1},"relationship":{"type":"string","minLength":1}}}
  }
}
