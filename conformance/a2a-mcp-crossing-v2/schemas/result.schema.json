{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://minorityprophet.org/schema/a2a-mcp-crossing-result-v2.json",
  "type":"object","additionalProperties":false,
  "required":["profile","grade","cases_sha256","implementation","results"],
  "properties":{
    "profile":{"const":"https://minorityprophet.org/conformance/a2a-mcp-crossing/v2"},
    "grade":{"enum":["reference_fixture","transport_real","implementation_independent","operator_independent"]},
    "cases_sha256":{"const":"0a03b3cc6188c012f92809334201681308a670d741ea9a2eabe5159ba4c1d04c"},
    "implementation":{"type":"object","additionalProperties":false,"required":["a2a","mcp","verifier","operator"],"properties":{"a2a":{"type":"string"},"mcp":{"type":"string"},"verifier":{"type":"string"},"operator":{"type":"string"}}},
    "results":{"type":"array","minItems":17,"maxItems":17,"prefixItems":[
      {"$ref":"#/$defs/valid_crossing"},{"$ref":"#/$defs/caller_swap"},{"$ref":"#/$defs/message_swap"},{"$ref":"#/$defs/task_swap"},{"$ref":"#/$defs/context_swap"},{"$ref":"#/$defs/audience_swap"},{"$ref":"#/$defs/tool_swap"},{"$ref":"#/$defs/arguments_swap"},{"$ref":"#/$defs/nonce_substitution"},{"$ref":"#/$defs/authority_id_swap"},{"$ref":"#/$defs/authority_digest_swap"},{"$ref":"#/$defs/not_yet_valid"},{"$ref":"#/$defs/expired"},{"$ref":"#/$defs/status_ref_swap"},{"$ref":"#/$defs/revoked"},{"$ref":"#/$defs/stale_status"},{"$ref":"#/$defs/replay"}
    ],"items":false}
  },
  "$defs":{
    "attempt":{"type":"object","additionalProperties":false,"required":["attempt","outcome","reason","effect_before","effect_after","effect_delta"],"properties":{"attempt":{"type":"integer","minimum":1},"outcome":{"enum":["succeed","reject","non_comparable"]},"reason":{"enum":["accepted","profile_mismatch","authority_digest_mismatch","authority_id_mismatch","task_binding_unresolved","caller_mismatch","message_mismatch","task_mismatch","context_mismatch","audience_mismatch","action_digest_mismatch","not_yet_valid","expired","status_reference_mismatch","status_stale","authority_not_current","nonce_replay","adapter_non_comparable"]},"effect_before":{"type":"integer","minimum":0},"effect_after":{"type":"integer","minimum":0},"effect_delta":{"type":"integer","minimum":0,"maximum":1}}},
    "lane":{"type":"object","additionalProperties":false,"required":["measurement","attempts"],"properties":{"measurement":{"enum":["measured","not_measured"]},"attempts":{"type":"array","items":{"$ref":"#/$defs/attempt"}}}},
    "caseResult":{"type":"object","additionalProperties":false,"required":["case","native","bound"],"properties":{"case":{"type":"string"},"native":{"$ref":"#/$defs/lane"},"bound":{"$ref":"#/$defs/lane"}}},
    "valid_crossing":{"allOf":[{"$ref":"#/$defs/caseResult"},{"properties":{"case":{"const":"valid_crossing"}}}]},
    "caller_swap":{"allOf":[{"$ref":"#/$defs/caseResult"},{"properties":{"case":{"const":"caller_swap"}}}]},
    "message_swap":{"allOf":[{"$ref":"#/$defs/caseResult"},{"properties":{"case":{"const":"message_swap"}}}]},
    "task_swap":{"allOf":[{"$ref":"#/$defs/caseResult"},{"properties":{"case":{"const":"task_swap"}}}]},
    "context_swap":{"allOf":[{"$ref":"#/$defs/caseResult"},{"properties":{"case":{"const":"context_swap"}}}]},
    "audience_swap":{"allOf":[{"$ref":"#/$defs/caseResult"},{"properties":{"case":{"const":"audience_swap"}}}]},
    "tool_swap":{"allOf":[{"$ref":"#/$defs/caseResult"},{"properties":{"case":{"const":"tool_swap"}}}]},
    "arguments_swap":{"allOf":[{"$ref":"#/$defs/caseResult"},{"properties":{"case":{"const":"arguments_swap"}}}]},
    "nonce_substitution":{"allOf":[{"$ref":"#/$defs/caseResult"},{"properties":{"case":{"const":"nonce_substitution"}}}]},
    "authority_id_swap":{"allOf":[{"$ref":"#/$defs/caseResult"},{"properties":{"case":{"const":"authority_id_swap"}}}]},
    "authority_digest_swap":{"allOf":[{"$ref":"#/$defs/caseResult"},{"properties":{"case":{"const":"authority_digest_swap"}}}]},
    "not_yet_valid":{"allOf":[{"$ref":"#/$defs/caseResult"},{"properties":{"case":{"const":"not_yet_valid"}}}]},
    "expired":{"allOf":[{"$ref":"#/$defs/caseResult"},{"properties":{"case":{"const":"expired"}}}]},
    "status_ref_swap":{"allOf":[{"$ref":"#/$defs/caseResult"},{"properties":{"case":{"const":"status_ref_swap"}}}]},
    "revoked":{"allOf":[{"$ref":"#/$defs/caseResult"},{"properties":{"case":{"const":"revoked"}}}]},
    "stale_status":{"allOf":[{"$ref":"#/$defs/caseResult"},{"properties":{"case":{"const":"stale_status"}}}]},
    "replay":{"allOf":[{"$ref":"#/$defs/caseResult"},{"properties":{"case":{"const":"replay"}}}]}
  }
}
