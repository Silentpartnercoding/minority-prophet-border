# Public, non-secret configuration
MP_BASE_URL=https://interop.example.org
MP_AUTHORIZATION_SERVER_ISSUER=https://issuer.example.org
MP_TOKEN_AUDIENCE=https://interop.example.org/mcp
MP_REQUIRED_SCOPE=interop:echo
MP_TOKEN_ALGORITHMS=RS256,PS256,ES256,EdDSA
MP_CLOCK_SKEW_SECONDS=30
MP_SQLITE_PATH=/data/openid-sandbox.sqlite3

# Generate these with `minority-prophet-border-keygen` and store them only in
# the deployment platform's protected secret store. The JWKS is public data,
# but keeping all environment-specific values out of Git avoids drift.
MP_CLIENT_JWKS_JSON={"keys":[{"kty":"EC","use":"sig","alg":"ES256","kid":"replace-me","crv":"P-256","x":"replace-me","y":"replace-me"}]}
MP_BORDER_STAMP_KEY_B64=replace-with-base64-32-byte-key

# Optional outbound client half. Add these only after selecting a partner.
# Hash a fresh operator token with: printf %s "$TOKEN" | shasum -a 256
MP_CLIENT_PRIVATE_KEY_PATH=/run/secrets/client-private-key.pem
MP_DOWNSTREAM_RESOURCE=https://partner-mcp.example.org/mcp
MP_OPERATOR_TOKEN_SHA256=replace-with-lowercase-sha256
