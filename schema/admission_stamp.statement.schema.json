{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Minority Prophet Border Admission Stamp v1 in-toto Statement",
  "type": "object",
  "additionalProperties": false,
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": {"const": "https://in-toto.io/Statement/v1"},
    "subject": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "digest"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "digest": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha256"],
            "properties": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
          }
        }
      }
    },
    "predicateType": {"const": "https://minority-prophet.dev/border-admission/v1"},
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "bindings"],
      "properties": {
        "schema": {"const": "border-admission-stamp/v1"},
        "bindings": {"$ref": "admission_stamp_bindings.schema.json"}
      }
    }
  }
}
